# BoardService RS — 多阶段 Rust 构建
# 使用: docker build -f Dockerfile.board_service_rs -t board-service-rs .
# 运行: docker run --rm -e MQTT_HOST=host.docker.internal -e DB_HOST=host.docker.internal board-service-rs

# === Stage 1: 编译 ===
FROM rust:1.75-slim-bookworm AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 先复制依赖清单，利用 Docker 缓存
COPY tools/board_service_rs/Cargo.toml tools/board_service_rs/Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release 2>/dev/null || true && \
    rm -rf src

# 再复制真实源码
COPY tools/board_service_rs/src ./src
RUN cargo build --release

# === Stage 2: 运行 ===
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/board_service_rs /usr/local/bin/board_service_rs

# Healthcheck: MQTT 连接检测（需 broker 运行）
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD timeout 5 bash -c 'echo > /dev/tcp/${MQTT_HOST:-127.0.0.1}/${MQTT_PORT:-1883}' || exit 1

ENTRYPOINT ["board_service_rs"]
