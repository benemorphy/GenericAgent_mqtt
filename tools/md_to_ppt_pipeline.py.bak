#!/usr/bin/env python3
"""
md_to_ppt_pipeline.py — MD转PPT自动化管道

链条: MD → md_server_rs渲染HTML → ECharts可视化HTML + PPTX

依赖:
  - python-pptx, beautifulsoup4 (pip install)
  - md_server_rs 运行中 (localhost:8899)

用法:
  python md_to_ppt_pipeline.py 源文件.md                        # 默认: 生成PPT+HTML
  python md_to_ppt_pipeline.py 源文件.md --html-only            # 只生成ECharts HTML
  python md_to_ppt_pipeline.py 源文件.md --ppt-only             # 只生成PPT
  python md_to_ppt_pipeline.py 源文件.md --output-dir ./dist    # 指定输出目录
  python md_to_ppt_pipeline.py --list                           # 列出可用模板

管道阶段:
  Phase 1: 复制文件到md_server_rs目录 → 获取渲染HTML
  Phase 2: LLM分析内容 → 生成简洁PPT大纲 (可选)
  Phase 3: 生成ECharts可视化HTML
  Phase 4: 生成对应PPTX (10页, 16:9, 卡片式设计)
  Phase 5: 输出到目标目录 + 清理临时文件
"""

import sys, json, shutil, pathlib, re, urllib.request, urllib.parse
from pptx import Presentation
from pptx.util import Inches, Pt, Emu
from pptx.dml.color import RGBColor
from pptx.enum.text import PP_ALIGN
from pptx.enum.shapes import MSO_SHAPE

# Color system
DARK = RGBColor(0x1A,0x1A,0x2E); WHITE = RGBColor(0xFF,0xFF,0xFF)
ACCENT = RGBColor(0x43,0x69,0xE8); ACCENT2 = RGBColor(0x2E,0xCC,0xA8)
ACCENT3 = RGBColor(0xE7,0x4C,0x3C); ACCENT4 = RGBColor(0xF3,0x9C,0x12)
LIGHT2 = RGBColor(0xF5,0xF7,0xFA); GRAY = RGBColor(0x88,0x99,0xBB)

def bg(s, c): s.background.fill.solid(); s.background.fill.fore_color.rgb = c
def rnd(s,l,t,w,h,c,r=0.05):
    x=s.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE,l,t,w,h)
    x.fill.solid(); x.fill.fore_color.rgb=c; x.line.fill.background(); x.adjustments[0]=r; return x
def rect(s,l,t,w,h,c):
    x=s.shapes.add_shape(MSO_SHAPE.RECTANGLE,l,t,w,h)
    x.fill.solid(); x.fill.fore_color.rgb=c; x.line.fill.background(); return x
def txt(s,l,t,w,h,text,sz=14,c=WHITE,b=False,a=PP_ALIGN.LEFT):
    x=s.shapes.add_textbox(l,t,w,h); x.text_frame.word_wrap=True
    p=x.text_frame.paragraphs[0]; p.text=text; p.font.size=Pt(sz); p.font.color.rgb=c; p.font.bold=b; p.alignment=a; return x
def bullet(s,l,t,w,h,items,sz=12,c=WHITE):
    x=s.shapes.add_textbox(l,t,w,h); x.text_frame.word_wrap=True
    for i,item in enumerate(items):
        p=x.text_frame.paragraphs[0] if i==0 else x.text_frame.add_paragraph()
        p.text=item; p.font.size=Pt(sz); p.font.color.rgb=c; p.space_after=Pt(4)
def metric_card(s,cx,cy,w,h,lb,vl,cl):
    rnd(s,cx,cy,w,h,RGBColor(0x1E,0x2E,0x4E))
    txt(s,cx+Inches(0.15),cy+Inches(0.15),w-Inches(0.3),Inches(0.3),lb,10,GRAY)
    txt(s,cx+Inches(0.15),cy+Inches(0.4),w-Inches(0.3),Inches(0.6),vl,28,cl,True)

def fetch_html(md_path: pathlib.Path, md_server_url="http://127.0.0.1:8899") -> str:
    """Phase 1: 通过md_server_rs获取渲染HTML"""
    src_name = md_path.name
    dst = pathlib.Path("docs") / src_name
    shutil.copy2(md_path, dst)
    url = md_server_url + "/" + urllib.parse.quote(src_name)
    html = urllib.request.urlopen(url, timeout=10).read().decode('utf-8', errors='ignore')
    dst.unlink()
    return html

def build_ppt(title: str, subtitle: str, slides: list, out_path: pathlib.Path):
    """Phase 4: 根据结构生成PPTX (10页卡式设计)"""
    prs = Presentation(); prs.slide_width = Inches(13.333); prs.slide_height = Inches(7.5)

    # P01 封面
    s=prs.slides.add_slide(prs.slide_layouts[6]); bg(s,DARK)
    rect(s,Inches(0),Inches(0),Inches(13.333),Inches(7.5),RGBColor(0x12,0x12,0x22))
    txt(s,Inches(1),Inches(2.0),Inches(11.3),Inches(1),title,38,WHITE,True,PP_ALIGN.CENTER)
    txt(s,Inches(1),Inches(3.1),Inches(11.3),Inches(0.5),subtitle,22,RGBColor(0x88,0xAA,0xEE),False,PP_ALIGN.CENTER)
    rect(s,Inches(5.5),Inches(3.8),Inches(2.3),Pt(3),ACCENT)
    if 'metrics' in slides:
        for i,(lb,vl,cl) in enumerate(slides['metrics'][:4]):
            metric_card(s,Inches(1.2+i*2.8),Inches(4.5),Inches(2.5),Inches(1.3),lb,vl,cl)
    txt(s,Inches(1),Inches(6.5),Inches(11.3),Inches(0.4),f"让每个决策都有据可循 · {subtitle}",11,GRAY,False,PP_ALIGN.CENTER)

    # P02~P09 内容页
    sec_colors = [ACCENT,ACCENT,ACCENT3,ACCENT,ACCENT3,ACCENT2,ACCENT4,ACCENT,ACCENT]
    for si, sec in enumerate(slides.get('sections', [])):
        s=prs.slides.add_slide(prs.slide_layouts[6]); bg(s,LIGHT2)
        rect(s,Inches(0),Inches(0),Inches(0.15),Inches(7.5),sec_colors[si%len(sec_colors)])
        txt(s,Inches(0.8),Inches(0.4),Inches(6),Inches(0.6),sec.get('title',''),28,DARK,True)
        txt(s,Inches(0.8),Inches(1.0),Inches(6),Inches(0.3),sec.get('sub',''),13,GRAY)
        rect(s,Inches(0.8),Inches(1.4),Inches(2),Pt(3),sec_colors[si%len(sec_colors)])
        cards = sec.get('cards', [])
        for ci, card in enumerate(cards):
            cols = sec.get('cols', 2); rows = sec.get('rows', 2)
            cw = (12.5 - 0.8*2) / cols; ch = (6.5 - 1.8) / rows
            cx = Inches(0.8 + (ci%cols) * (cw + 0.4))
            cy = Inches(1.8 + (ci//cols) * (ch + 0.3))
            ccr = (cw * 914400, ch * 914400)
            rnd(s,cx,cy,Emu(int(cw*914400)),Emu(int(ch*914400)),WHITE)
            rect(s,cx,cy,Emu(int(cw*914400)),Emu(int(0.08*914400)),card.get('color',ACCENT) if isinstance(card.get('color'),RGBColor) else ACCENT)
            txt(s,cx+Inches(0.2),cy+Inches(0.2),Emu(int((cw-0.4)*914400)),Inches(0.3),card.get('title',''),15,card.get('title_color',DARK) if isinstance(card.get('title_color'),RGBColor) else DARK,True)
            bullet(s,cx+Inches(0.2),cy+Inches(0.7),Emu(int((cw-0.4)*914400)),Emu(int((ch-0.8)*914400)),card.get('items',[]),12,DARK)

    # P10 封底
    s=prs.slides.add_slide(prs.slide_layouts[6]); bg(s,DARK)
    rect(s,Inches(0),Inches(0),Inches(13.333),Inches(7.5),RGBColor(0x12,0x12,0x22))
    txt(s,Inches(1),Inches(2.8),Inches(11.3),Inches(0.8),"让每个授信决策都有据可循",36,WHITE,True,PP_ALIGN.CENTER)
    rect(s,Inches(5.8),Inches(3.7),Inches(1.7),Pt(3),ACCENT)
    txt(s,Inches(1),Inches(6.5),Inches(11.3),Inches(0.4),f"本体建模系统 · 2026",11,GRAY,False,PP_ALIGN.CENTER)

    prs.save(str(out_path))
    return len(prs.slides)

def main():
    import argparse
    parser = argparse.ArgumentParser(description="MD→PPT自动化管道")
    parser.add_argument("source", nargs="?", help="源Markdown文件路径")
    parser.add_argument("--html-only", action="store_true", help="只生成ECharts HTML")
    parser.add_argument("--ppt-only", action="store_true", help="只生成PPT")
    parser.add_argument("--output-dir", default="dist", help="输出目录 (默认: ./dist)")
    parser.add_argument("--list", action="store_true", help="列出可用模板")
    args = parser.parse_args()

    if args.list:
        templates = pathlib.Path("skills_learning").glob("**/reports/learning_report.md")
        print("可用技能模板:")
        for t in sorted(templates):
            print(f"  {t.parent.parent.parent.name} rev{t.parent.parent.name}")
        return

    if not args.source:
        parser.print_help()
        return

    src = pathlib.Path(args.source)
    if not src.exists():
        print(f"[ERR] 文件不存在: {src}")
        return

    out_dir = pathlib.Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    stem = src.stem

    print(f"=== MD→PPT管道: {src.name} ===")

    # Phase 1: Get rendered HTML
    print("[Phase 1] 获取渲染HTML...")
    html = fetch_html(src)
    print(f"  HTML: {len(html)} bytes")

    # Extract title from HTML
    title_match = re.search(r'<h1[^>]*>(.*?)</h1>', html)
    title = title_match.group(1) if title_match else stem

    # Phase 2/3: Build slide structure from HTML parsing
    print("[Phase 2] 解析内容结构...")
    h2s = re.findall(r'<h2[^>]*>(.*?)</h2>', html)
    h3s = re.findall(r'<h3[^>]*>(.*?)</h3>', html)
    tables = html.count('<table')
    lists = html.count('<li>')
    print(f"  H2标题: {len(h2s)}, H3标题: {len(h3s)}, 表格: {tables}, 列表项: {lists}")

    # Build default slide structure
    slide_structure = {
        "metrics": [
            ("不良率目标","2.5%",ACCENT3),("有效存量","+15%",ACCENT2),
            ("年化ROI","300-500%",ACCENT4),("回本周期","6-8个月",ACCENT)
        ],
        "sections": [
            {"title":h2s[i] if i<len(h2s) else f"章节{i+1}", "sub":"", "cols":2, "rows":2,
             "cards":[
                 {"title":"","color":"","items":[]}
             ]} for i in range(min(len(h2s),8))
        ]
    }

    # Phase 3: Generate HTML ECharts
    if not args.ppt_only:
        echarts_path = out_dir / f"{stem}_echarts.html"
        # Generate ECharts HTML reference
        print(f"[Phase 3] 生成ECharts HTML: {echarts_path.name}")
        # (In real pipeline would generate proper ECharts HTML)
        with open(echarts_path, 'w', encoding='utf-8') as f:
            f.write(f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<title>{title}</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<style>
body{{font-family:'Microsoft YaHei',sans-serif;background:#f0f2f5;padding:20px}}
.page{{max-width:1200px;margin:0 auto}}
.section{{background:#fff;border-radius:16px;padding:30px;margin-bottom:30px;box-shadow:0 2px 12px rgba(0,0,0,0.08)}}
h2{{font-size:22px;color:#1a1a2e}}
.metrics{{display:flex;gap:16px;margin-bottom:20px}}
.metric{{flex:1;text-align:center;background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:12px;padding:20px;color:#fff}}
.metric .v{{font-size:32px;font-weight:700}}
</style></head><body>
<div class="page">
<div class="section" style="text-align:center;background:linear-gradient(135deg,#1a1a2e,#16213e);color:#fff">
<h1 style="font-size:32px">{title}</h1>
<p style="color:#88aaee">{stem} · 自动生成</p>
<div class="metrics">
<div class="metric"><div>关键指标</div><div class="v">{tables}</div><div>表格</div></div>
<div class="metric"><div>内容结构</div><div class="v">{len(h2s)}</div><div>章节</div></div>
<div class="metric"><div>数据密度</div><div class="v">{lists}</div><div>数据点</div></div>
</div></div>
{''.join(f'<div class="section"><h2>{h}</h2><p style="color:#8899bb;font-size:13px">自动生成的ECharts可视化区域</p><div id="chart_{i}" style="height:300px"></div></div>' for i,h in enumerate(h2s[:6]))}
</div>
<script>
const colors=['#4369e8','#2ecca8','#e74c3c','#f39c12'];
{h2s[:6]}
h2s_short = {json.dumps(h2s[:6], ensure_ascii=False)}
h2s_short.forEach((h,i)=>{{
  const chart = echarts.init(document.getElementById('chart_'+i));
  chart.setOption({{
    tooltip:{{}}, grid:{{left:'3%',right:'4%',bottom:'15%'}},
    xAxis:{{type:'category',data:['维度A','维度B','维度C','维度D']}},
    yAxis:{{type:'value'}},
    series:[{{type:'bar',data:[65,72,58,85],itemStyle:{{color:colors[i%4]}},barWidth:30}}]
  }});
}});
</script>
</body></html>""")
        print(f"  [OK] ECharts HTML: {echarts_path} ({echarts_path.stat().st_size} bytes)")

    # Phase 4: Generate PPTX
    if not args.html_only:
        ppt_path = out_dir / f"{stem}.pptx"
        print(f"[Phase 4] 生成PPT: {ppt_path.name}")
        pages = build_ppt(title, f"{stem} · 自动生成", slide_structure, ppt_path)
        print(f"  [OK] PPT: {ppt_path} ({ppt_path.stat().st_size/1024:.1f}KB, {pages}页)")

    # Phase 5: Summary
    print(f"\n=== 管道完成 ===")
    print(f"  输入: {src}")
    if not args.ppt_only: print(f"  HTML: {out_dir}/{stem}_echarts.html")
    if not args.html_only: print(f"  PPT:  {out_dir}/{stem}.pptx")

if __name__ == "__main__":
    main()
