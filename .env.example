# GA Environment Configuration
# Copy to .env and fill in values before running.

# === LLM API ===
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_API_BASE=
LLM_CACHE_DIR=./temp/llm_cache
LLM_CACHE_ENABLE=true
DEEPSEEK_API_KEY=

# === MQTT ===
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
BRIDGE_HOST=
BRIDGE_PORT=

# === Database ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=genericagent
DB_TIMEOUT=3
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# === Authentication ===
GITHUB_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRY_SECONDS=86400

# === Feishu Bot ===
FEISHU_ALLOWED_USERS=*

# === Agent ===
GA_LANG=zh
GOAL_STATE=
CURIOSITY_ENABLED=true

# === Paths (optional, discovery falls back to PATH) ===
FFMPEG_PATH=
FFPROBE_PATH=
MOSQUITTO_HOME=

# === Monitoring ===
OBSERVABILITY_ENABLED=true
OBSERVABILITY_PORT=9090
GATEWAY_HEALTHCHECK=/health
LOG_DIR=./logs
LOG_LEVEL=INFO
