{"ts": 1778727466.5954902, "response": "[\n  {\n    \"id\": \"P_001\",\n    \"principle\": \"使用Docker Compose定义多容器应用时，应明确指定服务依赖关系（depends_on），确保容器按正确顺序启动，并考虑健康检查（healthcheck）以增强生产环境的可靠性。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_002\",\n    \"principle\": \"在生产部署中，应为每个服务配置资源限制（如CPU、内存），通过Docker Compose的deploy.resources设置，防止单个服务耗尽主机资源。\",\n    \"confidence\": 80,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_003\",\n    \"principle\": \"使用Docker Compose时，应将敏感信息（如密码、API密钥）通过环境变量或Docker Secrets管理，避免硬编码在docker-compose.yml文件中。\",\n    \"confidence\": 90,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_004\",\n    \"principle\": \"为生产环境配置日志驱动和日志轮转（如使用json-file驱动并设置max-size和max-file），避免容器日志无限增长导致磁盘空间耗尽。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_005\",\n    \"principle\": \"在Docker Compose文件中使用命名卷（named volumes）或绑定挂载（bind mounts）持久化数据，并定期备份卷数据，确保数据不因容器重启而丢失。\",\n    \"confidence\": 90,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_006\",\n    \"principle\": \"生产环境中应使用Docker Compose的restart策略（如always或unless-stopped）确保容器在崩溃后自动重启，提高服务可用性。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_007\",\n    \"principle\": \"为每个服务定义网络（networks），将前端、后端和数据库隔离到不同网络，减少攻击面并控制服务间通信。\",\n    \"confidence\": 80,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_008\",\n    \"principle\": \"使用Docker Compose的healthcheck指令为关键服务定义健康检查，结合depends_on的condition: service_healthy，确保依赖服务就绪后再启动下游服务。\",\n    \"confidence\": 75,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_009\",\n    \"principle\": \"在Docker Compose中为生产环境指定镜像标签为具体版本（如v1.2.3），避免使用latest标签，确保部署的可重复性和可追溯性。\",\n    \"confidence\": 90,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_010\",\n    \"principle\": \"使用Docker Compose的profiles功能区分开发、测试和生产环境配置，避免维护多个docker-compose文件，同时保持配置一致性。\",\n    \"confidence\": 70,\n    \"level\": \"advanced\"\n  }\n]"}