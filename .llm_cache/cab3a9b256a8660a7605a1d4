{"ts": 1778726928.5457354, "response": "[\n  {\n    \"id\": \"P_001\",\n    \"principle\": \"在Docker Compose生产部署中，应使用明确的镜像标签（如版本号或Git提交哈希），而非latest标签，以确保部署的可重复性和可追溯性。\",\n    \"confidence\": 90,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_002\",\n    \"principle\": \"生产环境下的Docker Compose文件应配置资源限制（如CPU和内存），防止单个容器耗尽主机资源，保障服务稳定性。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_003\",\n    \"principle\": \"使用Docker Compose时，应将敏感信息（如密码、API密钥）通过环境变量或Docker Secrets管理，避免硬编码在配置文件中。\",\n    \"confidence\": 88,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_004\",\n    \"principle\": \"生产部署中应为每个服务配置健康检查（healthcheck），以便Docker Compose自动检测服务状态并重启异常容器。\",\n    \"confidence\": 82,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_005\",\n    \"principle\": \"Docker Compose文件应使用版本3或更高版本，以支持swarm模式或编排工具（如Kubernetes）的兼容性，便于扩展。\",\n    \"confidence\": 75,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_006\",\n    \"principle\": \"生产环境中应启用日志驱动（如json-file或syslog），并配置日志轮转策略，避免日志文件无限增长导致磁盘空间耗尽。\",\n    \"confidence\": 80,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_007\",\n    \"principle\": \"在Docker Compose中，应将持久化数据（如数据库文件）挂载到命名卷（named volumes）而非绑定挂载，以简化备份和迁移。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_008\",\n    \"principle\": \"生产部署应使用多阶段构建（multi-stage builds）优化镜像大小，减少攻击面并提升部署速度。\",\n    \"confidence\": 78,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_009\",\n    \"principle\": \"Docker Compose生产配置中应显式设置网络模式（如自定义bridge网络），避免使用默认网络，以增强服务隔离和安全性。\",\n    \"confidence\": 80,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_010\",\n    \"principle\": \"生产环境应使用Docker Compose的depends_on条件（如condition: service_healthy）确保服务启动顺序，避免依赖服务未就绪导致错误。\",\n    \"confidence\": 72,\n    \"level\": \"advanced\"\n  }\n]"}