{"ts": 1779148389.0148137, "response": "[\n  {\"id\": \"P_001\", \"principle\": \"根据应用需求选择合适的QoS级别（0、1、2），在可靠性和性能之间权衡，确保消息传递的恰当保障。\", \"confidence\": 90, \"level\": \"domain\"},\n  {\"id\": \"P_002\", \"principle\": \"配置遗嘱消息（Will Message），在客户端异常断开时由服务器自动发布预设消息，通知其他订阅者。\", \"confidence\": 88, \"level\": \"domain\"},\n  {\"id\": \"P_003\", \"principle\": \"合理设置Clean Start和Session Expiry Interval，以控制会话的持久性，实现状态恢复或每次重置。\", \"confidence\": 85, \"level\": \"domain\"},\n  {\"id\": \"P_004\", \"principle\": \"使用TLS/SSL加密通信，并结合用户名/密码或证书认证，防止数据窃听和未授权接入。\", \"confidence\": 90, \"level\": \"domain\"},\n  {\"id\": \"P_005\", \"principle\": \"设计分层主题结构（如/home/kitchen/temperature），避免使用过多通配符，提高可维护性和性能。\", \"confidence\": 85, \"level\": \"domain\"},\n  {\"id\": \"P_006\", \"principle\": \"利用Message Expiry Interval属性设置消息过期时间，自动清理过时数据，避免队列积压。\", \"confidence\": 80, \"level\": \"advanced\"},\n  {\"id\": \"P_007\", \"principle\": \"使用User Property属性携带自定义元数据（如时间戳、版本号），增强消息的可扩展性和上下文信息。\", \"confidence\": 82, \"level\": \"advanced\"},\n  {\"id\": \"P_008\", \"principle\": \"设置Payload Format Indicator和Content Type属性，帮助客户端正确解析和解释消息负载格式（如JSON、CBOR）。\", \"confidence\": 78, \"level\": \"advanced\"},\n  {\"id\": \"P_009\", \"principle\": \"利用Response Topic和Correlation Data属性实现请求-响应模式，使订阅者能够定向回复请求者的特定消息。\", \"confidence\": 75, \"level\": \"advanced\"},\n  {\"id\": \"P_010\", \"principle\": \"部署安全监控机制，如检测客户端异常行为（频繁重连、非法主题）和服务器受威胁迹象，及时采取措施。\", \"confidence\": 70, \"level\": \"advanced\"}\n]"}