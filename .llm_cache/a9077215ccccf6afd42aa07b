{"ts": 1778901986.0029433, "response": "[\n  {\n    \"id\": \"P_001\",\n    \"principle\": \"使用Erlang/OTP构建MQTT客户端时，应优先选择成熟的开源库（如emqtt、emqttc），这些库通常支持MQTT 3.1、3.1.1和5.0协议，并经过主流Broker（如Mosquitto、RabbitMQ、EMQX）的测试验证。\",\n    \"confidence\": 90,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_002\",\n    \"principle\": \"在Erlang shell中测试MQTT客户端时，需通过-pa参数添加编译后的库路径（如_build/default/lib/*/ebin），确保依赖模块可被加载。\",\n    \"confidence\": 85,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_003\",\n    \"principle\": \"MQTT客户端应支持通过命令行参数配置协议版本（-V）、用户名密码（-u/-P）、客户端ID（-C）、心跳间隔（-k）、主题（-t）和服务质量（-q），以提供灵活的连接选项。\",\n    \"confidence\": 80,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_004\",\n    \"principle\": \"实现MQTT客户端时，应支持遗嘱消息（Will Message）功能，通过--will-topic和--will-payload参数配置，以便在客户端意外断开时通知其他订阅者。\",\n    \"confidence\": 75,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_005\",\n    \"principle\": \"Erlang MQTT客户端应支持TCP/SSL Socket连接，并实现自动重连机制，以增强在网络不稳定环境下的可靠性。\",\n    \"confidence\": 85,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_006\",\n    \"principle\": \"在Erlang中开发MQTT客户端时，应遵循OTP设计原则，使用gen_server或gen_statem等行为模式管理连接状态，确保并发安全和状态一致性。\",\n    \"confidence\": 70,\n    \"level\": \"advanced\"\n  },\n  {\n    \"id\": \"P_007\",\n    \"principle\": \"MQTT客户端应支持QoS 0、QoS 1和QoS 2三种服务质量等级，以满足不同场景下消息传递的可靠性需求。\",\n    \"confidence\": 80,\n    \"level\": \"domain\"\n  },\n  {\n    \"id\": \"P_008\",\n    \"principle\": \"对于Erlang MQTT客户端，建议使用Erlang R17+版本，以利用更完善的并发特性和库支持。\",\n    \"confidence\": 65,\n    \"level\": \"domain\"\n  }\n]"}