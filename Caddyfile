:8000 {
	# 反向代理到 md_server_rs (文档, 8899) — md_server_rs 原生生成 /docs/ 前缀链接
	@docs path /docs* /docs/*
	handle @docs {
		uri strip_prefix /docs
		reverse_proxy 127.0.0.1:8899
	}

	# MQTT Web UI — Rust 面板，取代 Python Streamlit dashboard
	@mqtt path /mqtt* /mqtt/*
	handle @mqtt {
		reverse_proxy 127.0.0.1:8900
	}

	# simphtml_rs — HTML 简化引擎 (API, 8901)
	@simphtml path /simphtml* /simphtml/*
	handle @simphtml {
		uri strip_prefix /simphtml
		reverse_proxy 127.0.0.1:8901
	}

	# A-supply-analysis 供应链数据 — 端口 8765
	@supply path /supply* /supply/*
	handle @supply {
		uri strip_prefix /supply
		reverse_proxy 127.0.0.1:8765
	}

	# BoardService RS Metrics — 健康检查 (9100)
	@boardmetrics path /board-metrics* /board-metrics/*
	handle @boardmetrics {
		uri strip_prefix /board-metrics
		reverse_proxy 127.0.0.1:9100
	}

	# 其余所有请求转发到 FastAPI 后端
	handle {
		reverse_proxy 127.0.0.1:8001
	}
}
