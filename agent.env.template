# ====================================================
# Agent Environment Variables — Template
# ====================================================
# Copy this file to agent.env and fill in your values.
# NEVER commit agent.env to version control.

# --- MQTT Broker ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=<PLEASE_SET>
MQTT_PASSWORD=<PLEASE_SET>

# --- MQTT TLS (Phase2, optional) ---
MQTT_TLS_ENABLED=false
MQTT_TLS_PORT=8883
MQTT_TLS_CA_CERTS=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
MQTT_TLS_INSECURE=false

# --- Board Service ---
BBS_AGENT_ID=agent_alpha
BBS_BOARD_NAME=agent-bbs

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=Mqtt_bbs
DB_USER=root
DB_PASSWORD=<PLEASE_SET>

# --- JWT ---
JWT_SECRET=<PLEASE_SET>

# --- HMAC ---
HMAC_SECRET=<PLEASE_SET>

# --- Audit ---
MQTT_AUDIT_LOG_ENABLED=true
MQTT_AUDIT_LOG_TOPIC=system/audit/log
