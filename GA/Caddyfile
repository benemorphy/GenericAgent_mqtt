:8000 {
    # 反向代理到 FastAPI 后端 — md_server 需经 FastAPI 做 HTML 链接重写
    @mdserver path /md_server* /md_server/*
    handle @mdserver {
        reverse_proxy 127.0.0.1:8001
    }

    # 反向代理到 md_server_rs (文档, 20100)
    @docs path /docs* /docs/*
    handle @docs {
        uri strip_prefix /docs
        reverse_proxy 127.0.0.1:20100
    }

    # 反向代理到 mvivz — 需经 FastAPI 做 HTML 链接重写
    @mdviz path /mdviz* /mdviz/*
    handle @mdviz {
        reverse_proxy 127.0.0.1:8001
    }

    # MindFlow 课件引擎 — 直接代理（不剥离前缀，用于静态文件）
    @courseware path /courseware*
    handle @courseware {
        reverse_proxy 127.0.0.1:9900
    }

    # MindFlow 课件泛域名路由 — 剥离 /coursewares 前缀
    @coursewares path /coursewares* /coursewares/*
    handle @coursewares {
        uri strip_prefix /coursewares
        reverse_proxy 127.0.0.1:9900
    }

    # MindFlow 静态资源 — 直接代理到 9900
    @mfstatic path /static/coursewares/*
    handle @mfstatic {
        reverse_proxy 127.0.0.1:9900
    }

    # 其余所有请求转发到 FastAPI 后端
    handle {
        reverse_proxy 127.0.0.1:8001
    }
}
